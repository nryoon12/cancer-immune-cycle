Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"\[Kappa]1", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{".001", 
        RowBox[{"Length", "@", "resOneCycle"}]}]}], ")"}], 
     RowBox[{
     "\[Kappa]bpAll", "\[LeftDoubleBracket]", "1", 
      "\[RightDoubleBracket]"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"cycleH", "=", 
    RowBox[{"resOneCycle", "\[LeftDoubleBracket]", 
     RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ";", 
   "\[IndentingNewLine]", 
