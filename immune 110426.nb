Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"kk", "=", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Length", "[", "resOneCycle", "]"}], "+"}], "*)"}], "2"}], 
      ",", 
      RowBox[{"kk", "<", "37"}], ",", 
      RowBox[{"kk", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"diff", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"areaH", "=", "0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"resOneCycle", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"resOneCycle", ",", "cycleH"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"res", "=", 
         RowBox[{"MinimalBy", "[", 
          RowBox[{
           RowBox[{"resOneCycle", "\[LeftDoubleBracket]", 
            RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], ",", "Norm"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Kappa]1", "=", 
         RowBox[{"\[Kappa]1", "-", 
          RowBox[{".001", 
           RowBox[{
           "\[Kappa]bpAll", "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"parB", "=", 
         RowBox[{
          RowBox[{"par", "/.", 
           RowBox[{"\[Kappa]", "\[Rule]", "\[Kappa]1"}]}], "/.", 
          RowBox[{"Thread", "[", 
           RowBox[{"par", "\[Rule]", "par1"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{"diff", ">", 
           FractionBox["er", "10"]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"running", " ", "first", " ", "map"}], "*)"}], 
          RowBox[{
           RowBox[{"res", "=", 
            RowBox[{"{", 
             RowBox[{"res", "\[LeftDoubleBracket]", 
              RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "}"}]}], ";", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"res", "=", 
               RowBox[{"Append", "[", 
                RowBox[{"res", ",", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"T", ",", "L"}], "}"}], "/.", 
                  RowBox[{"FindRoot", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"SysF", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"T", ",", "L"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"par", "/.", 
                    RowBox[{"\[Kappa]", "\[Rule]", "\[Kappa]1"}]}], "/.", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"par", "\[Rule]", "parB"}], "]"}]}]}], "]"}], 
                    "\[Equal]", 
                    RowBox[{"res", "\[LeftDoubleBracket]", 
                    RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ",", 
                    RowBox[{"Thread", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"T", ",", "L"}], "}"}], ",", 
                    RowBox[{"res", "\[LeftDoubleBracket]", 
                    RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], "}"}], 
                    "]"}]}], "]"}]}]}], "]"}]}], ";", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"!", 
                   RowBox[{"Positive", "[", 
                    RowBox[{"res", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}],
                     "]"}]}], ")"}], "||", 
                 RowBox[{"(", 
                  RowBox[{"!", 
                   RowBox[{"Positive", "[", 
                    RowBox[{"res", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}],
                     "]"}]}], ")"}], "||", 
                 RowBox[{"(", 
                  RowBox[{"Positive", "[", 
                   RowBox[{
                    RowBox[{"res", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}],
                     "-", 
                    RowBox[{"10", 
                    RowBox[{
                    "eq2", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}]}]}], "]"}], ")"}], "||", 
                 RowBox[{"(", 
                  RowBox[{"Positive", "[", 
                   RowBox[{
                    RowBox[{"res", "\[LeftDoubleBracket]", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "2"}], "\[RightDoubleBracket]"}],
                     "-", 
                    RowBox[{"100", 
                    RowBox[{
                    "eq2", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}]}]}], "]"}], ")"}]}], ",", 
                "\[IndentingNewLine]", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Print", "[", "kk", "]"}], ";", 
                  RowBox[{"kk", "=", "100"}], ";", 
                  RowBox[{"diff", "=", "0"}], ";", 
                  RowBox[{"Break", "[", "]"}]}], ")"}]}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1000"}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"kk", "\[NotEqual]", "100"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"find", " ", "head"}], ",", " ", 
               RowBox[{"tail", " ", "cycle"}]}], "*)"}], 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"cycleT", "=", "cycleH"}], ";"}], "*)"}], " ", 
             RowBox[{
              RowBox[{"cycleH", "=", 
               RowBox[{"OneCycle", "[", 
                RowBox[{"res", ",", "eq1"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{
                RowBox[{"find", " ", "head"}], ",", " ", 
                RowBox[{"tail", " ", "cycle"}]}], "*)"}], 
              RowBox[{"areaT", "=", "areaH"}], ";", " ", 
              RowBox[{"areaH", "=", 
               RowBox[{"Area", "[", 
                RowBox[{"Polygon", "[", "cycleH", "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"diff", "=", 
               RowBox[{"Abs", "[", 
                RowBox[{"areaH", "-", "areaT"}], "]"}]}], ";"}]}], "]"}]}]}], 
         "\[IndentingNewLine]", "]"}], ";"}], ")"}]}], "\[IndentingNewLine]", 
     "]"}], ";", 
    RowBox[{"resOneCycle", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"resOneCycle", ",", "cycleH"}], "]"}]}], ";"}], ")"}], "//", 
  "AbsoluteTiming"}]], "Input",
