Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "@", "OneCycle"}], ";", 
  RowBox[{
   RowBox[{"OneCycle", "[", 
    RowBox[{"res0_", ",", "equil_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"jj", "=", "1"}], ";", 
     RowBox[{"ang", "=", "0"}], ";", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"ang", "<", 
        RowBox[{"2", "\[Pi]"}]}], ",", 
       RowBox[{
        RowBox[{"v1", "=", 
         RowBox[{
          RowBox[{"res0", "\[LeftDoubleBracket]", 
           RowBox[{"-", "jj"}], "\[RightDoubleBracket]"}], "-", "equil"}]}], 
        ";", 
        RowBox[{"v2", "=", 
         RowBox[{
          RowBox[{"res0", "\[LeftDoubleBracket]", 
           RowBox[{
            RowBox[{"-", "jj"}], "-", "1"}], "\[RightDoubleBracket]"}], "-", 
          "equil"}]}], ";", 
        RowBox[{"ang", "=", 
         RowBox[{"ang", "+", 
          RowBox[{"ArcCos", "[", 
           FractionBox[
            RowBox[{"v1", ".", "v2"}], 
            RowBox[{
             RowBox[{"Norm", "[", "v1", "]"}], 
             RowBox[{"Norm", "[", "v2", "]"}]}]], "]"}]}]}], ";", 
        RowBox[{"jj", "++"}], ";"}]}], "]"}], ";", 
     RowBox[{"res0", "\[LeftDoubleBracket]", 
      RowBox[{
       RowBox[{"-", "jj"}], ";;"}], "\[RightDoubleBracket]"}]}], ")"}]}], 
  ";"}]], "Input",
