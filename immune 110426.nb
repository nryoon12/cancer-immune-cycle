Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Lambda]", " ", "such", " ", "that", " ", 
      RowBox[{
       RowBox[{"(", 
        SuperscriptBox["\[Kappa]", "**"], ")"}], "'"}], 
      RowBox[{"(", "\[Lambda]", ")"}]}], "=", "0"}], ";", " ", 
    RowBox[{"vertical", " ", "tangent", " ", "line"}]}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"\[Mu]flat", "=", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Mu]", ",", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "9"}], "+", 
            RowBox[{"14", " ", "\[Mu]"}]}], ")"}], "+", 
          SqrtBox[
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "9"}], "+", 
               RowBox[{"14", " ", "\[Mu]"}]}], ")"}], "2"], "+", 
            RowBox[{"40", "\[Mu]", 
             RowBox[{"(", 
              RowBox[{"3", "+", 
               RowBox[{"2", "\[Mu]"}]}], ")"}]}]}]]}], 
         RowBox[{"10", 
          RowBox[{"(", 
           RowBox[{"3", "+", 
            RowBox[{"2", "\[Mu]"}]}], ")"}]}]]}], "}"}], "/.", 
      RowBox[{"\[Mu]", "\[Rule]", 
       RowBox[{"Range", "[", 
        RowBox[{".173", ",", ".693", ",", ".02"}], "]"}]}]}], "]"}]}], 
